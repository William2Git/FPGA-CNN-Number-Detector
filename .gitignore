Set-Content -Path .gitignore -Value @"
# Quartus generated folders and files
db/
incremental_db/
output_files/
simulation/
greybox_tmp/
hc_output/
*.rpt
*.summary
*.smsg
*.pin
*.sof
*.pof
*.jdi
*.sld
*.qws
*.bak
*.done
*.eqn
*.fld
*.htm
*.map
*.qdf

# ModelSim generated build, waveform, and local project files
work/
*.wlf
*.vstf
*.mpf
*.cr.mti
*.ver
transcript
vsim.dbg
modelsim.ini
"@